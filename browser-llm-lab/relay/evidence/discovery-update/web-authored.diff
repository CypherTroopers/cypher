+MESH_DISCOVERY_GATEWAYS=1 MESH_FORCE_DIRECT=1 MESH_EXPECT_NATIVE_CAPACITY=40 \
+MESH_CHECK_ABRUPT=1 MESH_CHECK_LIFECYCLE=1 MESH_CHECK_WORKLOAD=1 \
