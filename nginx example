# configuration file /etc/nginx/conf.d/test-rpc.conf:
log_format rpc_quic '$remote_addr [$time_local] '
                    '"$request" $status '
                    'http3="$http3" '
                    'server_protocol="$server_protocol" '
                    'request_time=$request_time '
                    'upstream_response_time=$upstream_response_time '
                    'upstream_addr=$upstream_addr';

upstream cypher_rpc {
    server 127.0.0.1:8000;
    keepalive 4096;
    keepalive_requests 100000;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name test.make-cph-great-again.community;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen 443 quic reuseport;

    http2 on;
    http3 on;
    http3_max_concurrent_streams 4096;

    server_name test.make-cph-great-again.community;

    ssl_certificate     /etc/letsencrypt/live/test.make-cph-great-again.community/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.make-cph-great-again.community/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header QUIC-Status $http3 always;

    quic_retry off;

    client_max_body_size 64m;
    client_body_buffer_size 16m;

    access_log off;
    error_log  /var/log/nginx/test-rpc.error.log warn;

    location / {
        proxy_http_version 1.1;

        proxy_set_header Host localhost;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_socket_keepalive on;

        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        proxy_request_buffering on;
        proxy_buffering off;
        proxy_next_upstream off;

        proxy_pass http://cypher_rpc;
    }
}
