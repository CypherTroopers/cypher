--- /dev/null
+++ b/leveldb/readbudget/budget.go
@@ -0,0 +1,171 @@
+// Copyright 2026 Cypher browser contributors.
+// Use of this source code is governed by the BSD-style LICENSE at the module root.
+
+// Package readbudget provides finite, monotonic budgets for the additive browser
+// read path. It does not bound pre-existing DB/cache memory, Go runtime overhead,
+// file descriptors, or the wall-clock duration of an in-flight synchronous I/O.
+package readbudget
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+var (
+	ErrLimit   = errors.New("bounded read budget exceeded")
+	ErrInvalid = errors.New("invalid bounded read budget")
+)
+
+type Limits struct {
+	MaxStoredBytes     uint64
+	MaxDecodedBytes    uint64
+	MaxValueBytes      uint64
+	MaxKeyBytes        uint64
+	MaxAllocationBytes uint64
+	MaxWork            uint64
+}
+
+// DefaultLimits are hard ceilings. Callers may only reduce them.
+func DefaultLimits() Limits { return Limits{128 << 20, 128 << 20, 32 << 20, 512, 256 << 20, 65536} }
+
+type Usage struct{ StoredBytes, DecodedBytes, AllocationBytes, Work uint64 }
+type ledger struct {
+	mu    sync.Mutex
+	usage Usage
+}
+type Budget struct {
+	ctx    context.Context
+	limits Limits
+	state  *ledger
+}
+
+func New(ctx context.Context, l Limits) (*Budget, error) {
+	if ctx == nil {
+		return nil, ErrInvalid
+	}
+	d := DefaultLimits()
+	for _, p := range [][2]uint64{{l.MaxStoredBytes, d.MaxStoredBytes}, {l.MaxDecodedBytes, d.MaxDecodedBytes}, {l.MaxValueBytes, d.MaxValueBytes}, {l.MaxKeyBytes, d.MaxKeyBytes}, {l.MaxAllocationBytes, d.MaxAllocationBytes}, {l.MaxWork, d.MaxWork}} {
+		if p[0] == 0 || p[0] > p[1] {
+			return nil, ErrInvalid
+		}
+	}
+	return &Budget{ctx: ctx, limits: l, state: &ledger{}}, nil
+}
+
+func (b *Budget) Check(ctx context.Context) error {
+	if b == nil || b.state == nil || b.ctx == nil || ctx == nil {
+		return ErrInvalid
+	}
+	if err := b.ctx.Err(); err != nil {
+		return err
+	}
+	return ctx.Err()
+}
+func (b *Budget) Limits() Limits {
+	if b == nil {
+		return Limits{}
+	}
+	return b.limits
+}
+func (b *Budget) Usage() Usage {
+	if b == nil || b.state == nil {
+		return Usage{}
+	}
+	b.state.mu.Lock()
+	defer b.state.mu.Unlock()
+	return b.state.usage
+}
+
+// WithValueLimit shares all aggregate counters and the lifetime context.
+func (b *Budget) WithValueLimit(n uint64) (*Budget, error) {
+	if b == nil || b.state == nil || n == 0 || n > b.limits.MaxValueBytes {
+		return nil, ErrInvalid
+	}
+	child := *b
+	child.limits.MaxValueBytes = n
+	return &child, nil
+}
+
+func add(v, n, max uint64) (uint64, bool) {
+	if n > max || v > max-n {
+		return v, false
+	}
+	return v + n, true
+}
+func (b *Budget) charge(ctx context.Context, stored, decoded, alloc, work uint64) error {
+	if err := b.Check(ctx); err != nil {
+		return err
+	}
+	b.state.mu.Lock()
+	defer b.state.mu.Unlock()
+	if err := b.Check(ctx); err != nil {
+		return err
+	}
+	u := b.state.usage
+	var ok bool
+	if u.StoredBytes, ok = add(u.StoredBytes, stored, b.limits.MaxStoredBytes); !ok {
+		return ErrLimit
+	}
+	if u.DecodedBytes, ok = add(u.DecodedBytes, decoded, b.limits.MaxDecodedBytes); !ok {
+		return ErrLimit
+	}
+	if u.AllocationBytes, ok = add(u.AllocationBytes, alloc, b.limits.MaxAllocationBytes); !ok {
+		return ErrLimit
+	}
+	if u.Work, ok = add(u.Work, work, b.limits.MaxWork); !ok {
+		return ErrLimit
+	}
+	b.state.usage = u
+	return nil
+}
+func (b *Budget) Step(ctx context.Context) error             { return b.charge(ctx, 0, 0, 0, 1) }
+func (b *Budget) Alloc(ctx context.Context, n uint64) error  { return b.charge(ctx, 0, 0, n, 0) }
+func (b *Budget) Stored(ctx context.Context, n uint64) error { return b.charge(ctx, n, 0, n, 0) }
+func (b *Budget) Decoded(ctx context.Context, n uint64, alloc bool) error {
+	a := uint64(0)
+	if alloc {
+		a = n
+	}
+	return b.charge(ctx, 0, n, a, 0)
+}
+func (b *Budget) CheckKey(n uint64, internal bool) error {
+	if b == nil || b.state == nil {
+		return ErrInvalid
+	}
+	max := b.limits.MaxKeyBytes
+	if internal {
+		max += 8
+	}
+	if n > max {
+		return ErrLimit
+	}
+	return nil
+}
+func (b *Budget) CopyValue(ctx context.Context, src []byte) ([]byte, error) {
+	if err := b.Check(ctx); err != nil {
+		return nil, err
+	}
+	if uint64(len(src)) > b.limits.MaxValueBytes {
+		return nil, ErrLimit
+	}
+	if err := b.Alloc(ctx, uint64(len(src))); err != nil {
+		return nil, err
+	}
+	dst := make([]byte, len(src))
+	for off := 0; off < len(src); {
+		if err := b.Step(ctx); err != nil {
+			return nil, err
+		}
+		n := len(src) - off
+		if n > 32<<10 {
+			n = 32 << 10
+		}
+		copy(dst[off:off+n], src[off:off+n])
+		off += n
+	}
+	if err := b.Check(ctx); err != nil {
+		return nil, err
+	}
+	return dst, nil
+}
diff --git a/leveldb/readbudget/budget_test.go b/leveldb/readbudget/budget_test.go
