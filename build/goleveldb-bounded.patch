+type browserSpyReader struct {
+	data          []byte
+	reads         int
+	allowedOffset int64
+	cancel        context.CancelFunc
+}
+
+func (r *browserSpyReader) ReadAt(dst []byte, off int64) (int, error) {
+	r.reads++
+	if r.cancel != nil {
+		r.cancel()
+	}
+	if off != r.allowedOffset && r.allowedOffset >= 0 {
+		return 0, stderrors.New("unexpected payload read")
+	}
+	return bytes.NewReader(r.data).ReadAt(dst, off)
+}
+func browserFooter(meta, index blockHandle) []byte {
+	f := make([]byte, footerLen)
+	n := encodeBlockHandle(f, meta)
+	encodeBlockHandle(f[n:], index)
+	copy(f[len(f)-len(magic):], magic)
+	return f
+}
+
+type browserFooterOnly struct {
+	footer []byte
+	off    int64
+	reads  int
+}
+
+func (r *browserFooterOnly) ReadAt(dst []byte, off int64) (int, error) {
+	r.reads++
+	if off != r.off {
+		return 0, stderrors.New("payload was read before limit")
+	}
+	return copy(dst, r.footer), nil
+}
+func TestBrowserBoundedStoredRejectsBeforePayloadAllocation(t *testing.T) {
+	r := &browserFooterOnly{footer: browserFooter(blockHandle{0, 1 << 20}, blockHandle{0, 1}), off: (1 << 20) + 5}
+	l := readbudget.DefaultLimits()
+	l.MaxStoredBytes = 64
+	b, _ := readbudget.New(context.Background(), l)
+	_, _, err := FindBounded(context.Background(), r, r.off+footerLen, browserTestKey("a"), browserNativeOptions(), b)
+	if !stderrors.Is(err, readbudget.ErrLimit) || r.reads != 1 || b.Usage().AllocationBytes != 0 {
+		t.Fatalf("err=%v reads=%d usage=%+v", err, r.reads, b.Usage())
+	}
+}
+func TestBrowserBoundedDecodedRejectsBeforeDecodedAllocation(t *testing.T) {
+	// A short Snappy block declares a huge decoded size. Length admission must
+	// precede both the decoded buffer and the decoder's payload validation.
+	var hdr [10]byte
+	n := binary.PutUvarint(hdr[:], 1<<30)
+	raw := append([]byte(nil), hdr[:n]...)
+	raw = append(raw, blockTypeSnappyCompression)
+	var crc [4]byte
+	binary.LittleEndian.PutUint32(crc[:], util.NewCRC(raw).Value())
+	raw = append(raw, crc[:]...)
+	bh := blockHandle{0, uint64(n)}
+	data := append(raw, browserFooter(bh, bh)...)
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	_, _, err := FindBounded(context.Background(), bytes.NewReader(data), int64(len(data)), browserTestKey("a"), browserNativeOptions(), b)
+	if !stderrors.Is(err, readbudget.ErrLimit) || b.Usage().DecodedBytes != 0 || b.Usage().AllocationBytes != uint64(len(raw)) {
+		t.Fatalf("%v %+v", err, b.Usage())
+	}
+}
+func TestBrowserBoundedBadHandleAndLateCancel(t *testing.T) {
+	f := browserFooter(blockHandle{0, 0}, blockHandle{0, 0})
+	for n := 0; n < 10; n++ {
+		f[n] = 255
+	}
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	if _, _, err := FindBounded(context.Background(), bytes.NewReader(f), int64(len(f)), browserTestKey("a"), browserNativeOptions(), b); err == nil {
+		t.Fatal("overflow handle accepted")
+	}
+	data := browserTestTable(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	r := &browserSpyReader{data: data, allowedOffset: -1, cancel: cancel}
+	b, _ = readbudget.New(context.Background(), readbudget.DefaultLimits())
+	if _, _, err := FindBounded(ctx, r, int64(len(data)), browserTestKey("a"), browserNativeOptions(), b); !stderrors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if r.reads != 1 || b.Usage().AllocationBytes != 0 {
+		t.Fatal(r.reads, b.Usage())
+	}
+}
