--- /dev/null
+++ b/leveldb/table/browser_bounded.go
@@ -0,0 +1,401 @@
+// Copyright 2026 Cypher browser contributors.
+// Use of this source code is governed by the BSD-style LICENSE at the module root.
+
+package table
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+
+	"github.com/golang/snappy"
+	"github.com/syndtr/goleveldb/leveldb/comparer"
+	"github.com/syndtr/goleveldb/leveldb/errors"
+	"github.com/syndtr/goleveldb/leveldb/opt"
+	"github.com/syndtr/goleveldb/leveldb/readbudget"
+	"github.com/syndtr/goleveldb/leveldb/util"
+)
+
+// FindBounded performs a private point lookup. It never opens or mutates a shared
+// table/block cache or uses BufferPool. It validates and charges meta, filter,
+// index, data and returned byte buffers before allocation. Filtering is optional
+// acceleration in the ordinary path; this path validates but does not consult it.
+// This entry accepts native internal-key SSTs only; options must supply their
+// internal comparer. It is not a generic plain-key replacement for Reader.Find.
+func FindBounded(ctx context.Context, f io.ReaderAt, size int64, key []byte, o *opt.Options, b *readbudget.Budget) ([]byte, []byte, error) {
+	if f == nil {
+		return nil, nil, readbudget.ErrInvalid
+	}
+	if err := b.Check(ctx); err != nil {
+		return nil, nil, err
+	}
+	if err := b.CheckKey(uint64(len(key)), true); err != nil {
+		return nil, nil, err
+	}
+	if len(key) < 8 {
+		return nil, nil, boundedCorrupt("short query internal key")
+	}
+	if size < footerLen {
+		return nil, nil, boundedCorrupt("short footer")
+	}
+	var footer [footerLen]byte
+	if err := boundedReadAt(ctx, f, footer[:], size-footerLen, b); err != nil {
+		return nil, nil, err
+	}
+	if !bytes.Equal(footer[footerLen-len(magic):], []byte(magic)) {
+		return nil, nil, boundedCorrupt("bad magic")
+	}
+	meta, n := boundedDecodeHandle(footer[:footerLen-len(magic)])
+	if n == 0 {
+		return nil, nil, boundedCorrupt("bad meta handle")
+	}
+	index, n2 := boundedDecodeHandle(footer[n : footerLen-len(magic)])
+	if n2 == 0 {
+		return nil, nil, boundedCorrupt("bad index handle")
+	}
+	r := boundedTable{ctx: ctx, f: f, end: uint64(size - footerLen), budget: b, cmp: o.GetComparer()}
+	metaData, err := r.raw(meta)
+	if err != nil {
+		return nil, nil, err
+	}
+	if err = validateBoundedBlock(ctx, metaData, comparer.DefaultComparer, false, b); err != nil {
+		return nil, nil, err
+	}
+	mi, err := newBoundedIter(ctx, metaData, b)
+	if err != nil {
+		return nil, nil, err
+	}
+	for mi.next(ctx) {
+		if bytes.HasPrefix(mi.key, []byte("filter.")) {
+			fh, n := boundedDecodeHandle(mi.value)
+			if n == 0 || n != len(mi.value) {
+				return nil, nil, boundedCorrupt("bad filter handle")
+			}
+			fd, err := r.raw(fh)
+			if err != nil {
+				return nil, nil, err
+			}
+			if len(fd) < 5 {
+				return nil, nil, boundedCorrupt("short filter")
+			}
+			off := uint64(binary.LittleEndian.Uint32(fd[len(fd)-5:]))
+			if off > uint64(len(fd)-5) || (uint64(len(fd)-5)-off)%4 != 0 {
+				return nil, nil, boundedCorrupt("bad filter offsets")
+			}
+		}
+	}
+	if mi.err != nil {
+		return nil, nil, mi.err
+	}
+	indexData, err := r.raw(index)
+	if err != nil {
+		return nil, nil, err
+	}
+	if err = validateBoundedBlock(ctx, indexData, r.cmp, true, b); err != nil {
+		return nil, nil, err
+	}
+	ii, err := newBoundedIter(ctx, indexData, b)
+	if err != nil {
+		return nil, nil, err
+	}
+	selected := false
+	for ii.next(ctx) {
+		if len(ii.key) < 8 {
+			return nil, nil, boundedCorrupt("short internal index key")
+		}
+		if !selected && r.cmp.Compare(ii.key, key) < 0 {
+			continue
+		}
+		selected = true
+		h, n := boundedDecodeHandle(ii.value)
+		if n == 0 || n != len(ii.value) {
+			return nil, nil, boundedCorrupt("bad data handle")
+		}
+		data, err := r.raw(h)
+		if err != nil {
+			return nil, nil, err
+		}
+		if err = validateBoundedBlock(ctx, data, r.cmp, true, b); err != nil {
+			return nil, nil, err
+		}
+		di, err := newBoundedIter(ctx, data, b)
+		if err != nil {
+			return nil, nil, err
+		}
+		for di.next(ctx) {
+			if len(di.key) < 8 {
+				return nil, nil, boundedCorrupt("short internal data key")
+			}
+			if r.cmp.Compare(di.key, key) < 0 {
+				continue
+			}
+			v, err := b.CopyValue(ctx, di.value)
+			if err != nil {
+				return nil, nil, err
+			}
+			// di.key already owns exact, bounded backing; no shared buffer survives.
+			if err = b.Check(ctx); err != nil {
+				return nil, nil, err
+			}
+			return di.key, v, nil
+		}
+		if di.err != nil {
+			return nil, nil, di.err
+		}
+		// The next index entry may contain the nearest greater key, just as Find.
+	}
+	if ii.err != nil {
+		return nil, nil, ii.err
+	}
+	if err = b.Check(ctx); err != nil {
+		return nil, nil, err
+	}
+	return nil, nil, ErrNotFound
+}
+
+type boundedTable struct {
+	ctx    context.Context
+	f      io.ReaderAt
+	end    uint64
+	budget *readbudget.Budget
+	cmp    comparer.Comparer
+}
+
+func boundedDecodeHandle(src []byte) (blockHandle, int) {
+	o, n := binary.Uvarint(src)
+	if n <= 0 {
+		return blockHandle{}, 0
+	}
+	l, m := binary.Uvarint(src[n:])
+	if m <= 0 {
+		return blockHandle{}, 0
+	}
+	return blockHandle{o, l}, n + m
+}
+func boundedCorrupt(reason string) error {
+	return &errors.ErrCorrupted{Err: &ErrCorrupted{Reason: reason}}
+}
+func boundedReadAt(ctx context.Context, f io.ReaderAt, dst []byte, off int64, b *readbudget.Budget) error {
+	for len(dst) > 0 {
+		if err := b.Step(ctx); err != nil {
+			return err
+		}
+		n := len(dst)
+		if n > 32<<10 {
+			n = 32 << 10
+		}
+		got, err := f.ReadAt(dst[:n], off)
+		if got != n {
+			if err != nil {
+				return err
+			}
+			return io.ErrUnexpectedEOF
+		}
+		if err != nil && err != io.EOF {
+			return err
+		}
+		off += int64(n)
+		dst = dst[n:]
+	}
+	return b.Check(ctx)
+}
+func (r *boundedTable) raw(h blockHandle) ([]byte, error) {
+	if err := r.budget.Step(r.ctx); err != nil {
+		return nil, err
+	}
+	// Subtraction checks avoid uint64 wrap and int/int64 conversion overflow.
+	if h.offset > r.end || h.length > r.end-h.offset || uint64(blockTrailerLen) > r.end-h.offset-h.length {
+		return nil, boundedCorrupt("block outside file")
+	}
+	n := h.length + uint64(blockTrailerLen)
+	if err := r.budget.Stored(r.ctx, n); err != nil {
+		return nil, err
+	}
+	buf := make([]byte, int(n)) // hard budget ceilings are below all supported int limits
+	if err := boundedReadAt(r.ctx, r.f, buf, int64(h.offset), r.budget); err != nil {
+		return nil, err
+	}
+	crc := util.CRC(0)
+	for off := 0; off < len(buf)-4; {
+		if err := r.budget.Step(r.ctx); err != nil {
+			return nil, err
+		}
+		end := off + (32 << 10)
+		if end > len(buf)-4 {
+			end = len(buf) - 4
+		}
+		crc = crc.Update(buf[off:end])
+		off = end
+	}
+	if crc.Value() != binary.LittleEndian.Uint32(buf[len(buf)-4:]) {
+		return nil, boundedCorrupt("checksum mismatch")
+	}
+	src := buf[:int(h.length)]
+	switch buf[int(h.length)] {
+	case blockTypeNoCompression:
+		if err := r.budget.Decoded(r.ctx, uint64(len(src)), false); err != nil {
+			return nil, err
+		}
+		return src, nil
+	case blockTypeSnappyCompression:
+		n, err := snappy.DecodedLen(src)
+		if err != nil {
+			return nil, boundedCorrupt("bad snappy length")
+		}
+		if err = r.budget.Decoded(r.ctx, uint64(n), true); err != nil {
+			return nil, err
+		}
+		dst := make([]byte, n)
+		out, err := snappy.Decode(dst[:0], src)
+		if err != nil {
+			return nil, boundedCorrupt("bad snappy block")
+		}
+		if len(out) != n {
+			return nil, boundedCorrupt("snappy length mismatch")
+		}
+		if err = r.budget.Check(r.ctx); err != nil {
+			return nil, err
+		}
+		return out, nil
+	default:
+		return nil, boundedCorrupt("unknown compression")
+	}
+}
+
+// A forward-only parser avoids the legacy iterator's unchecked restart slices
+// and append growth. Byte buffers are exact size and charged before growth.
+func validateBoundedBlock(ctx context.Context, data []byte, cmp comparer.Comparer, internal bool, b *readbudget.Budget) error {
+	it, err := newBoundedIter(ctx, data, b)
+	if err != nil {
+		return err
+	}
+	var previous []byte
+	first := true
+	for it.next(ctx) {
+		if internal && len(it.key) < 8 {
+			return boundedCorrupt("short internal key")
+		}
+		if !first && cmp.Compare(previous, it.key) >= 0 {
+			return boundedCorrupt("unordered block")
+		}
+		if len(it.key) > cap(previous) {
+			if err = b.Alloc(ctx, uint64(len(it.key))); err != nil {
+				return err
+			}
+			previous = make([]byte, len(it.key))
+		} else {
+			previous = previous[:len(it.key)]
+		}
+		copy(previous, it.key)
+		first = false
+	}
+	return it.err
+}
+
+type boundedIter struct {
+	data, restarts       []byte
+	end, pos, restartPos int
+	key, value           []byte
+	budget               *readbudget.Budget
+	err                  error
+}
+
+func newBoundedIter(ctx context.Context, data []byte, b *readbudget.Budget) (*boundedIter, error) {
+	if len(data) < 4 {
+		return nil, boundedCorrupt("short restart table")
+	}
+	n := uint64(binary.LittleEndian.Uint32(data[len(data)-4:]))
+	if n == 0 || n > uint64((len(data)-4)/4) {
+		return nil, boundedCorrupt("bad restart count")
+	}
+	end := len(data) - 4 - int(n*4)
+	prev := uint32(0)
+	for i := uint64(0); i < n; i++ {
+		if err := b.Step(ctx); err != nil {
+			return nil, err
+		}
+		o := binary.LittleEndian.Uint32(data[end+int(i*4):])
+		if (i == 0 && o != 0) || (i > 0 && o <= prev) || uint64(o) > uint64(end) {
+			return nil, boundedCorrupt("bad restart offset")
+		}
+		prev = o
+	}
+	return &boundedIter{data: data, restarts: data[end : len(data)-4], end: end, budget: b}, nil
+}
+func (i *boundedIter) next(ctx context.Context) bool {
+	if i.err != nil {
+		return false
+	}
+	if i.pos == i.end {
+		if i.end != 0 && i.restartPos != len(i.restarts) {
+			i.err = boundedCorrupt("unused restart point")
+		}
+		return false
+	}
+	if i.err = i.budget.Step(ctx); i.err != nil {
+		return false
+	}
+	if i.pos > i.end {
+		i.err = boundedCorrupt("entry outside block")
+		return false
+	}
+	src := i.data[i.pos:i.end]
+	shared, n0 := binary.Uvarint(src)
+	if n0 <= 0 {
+		i.err = boundedCorrupt("bad shared prefix")
+		return false
+	}
+	if i.restartPos < len(i.restarts) {
+		r := int(binary.LittleEndian.Uint32(i.restarts[i.restartPos:]))
+		if r < i.pos {
+			i.err = boundedCorrupt("restart inside entry")
+			return false
+		}
+		if r == i.pos {
+			if shared != 0 {
+				i.err = boundedCorrupt("restart has shared prefix")
+				return false
+			}
+			i.restartPos += 4
+		}
+	}
+	nkey, n1 := binary.Uvarint(src[n0:])
+	if n1 <= 0 {
+		i.err = boundedCorrupt("bad key length")
+		return false
+	}
+	nval, n2 := binary.Uvarint(src[n0+n1:])
+	if n2 <= 0 {
+		i.err = boundedCorrupt("bad value length")
+		return false
+	}
+	start := uint64(n0 + n1 + n2)
+	remain := uint64(len(src)) - start
+	if shared > uint64(len(i.key)) || nkey > remain || nval > remain-nkey {
+		i.err = boundedCorrupt("entry bounds")
+		return false
+	}
+	length := shared + nkey
+	if i.err = i.budget.CheckKey(length, true); i.err != nil {
+		return false
+	}
+	if length > uint64(cap(i.key)) {
+		if i.err = i.budget.Alloc(ctx, length); i.err != nil {
+			return false
+		}
+		next := make([]byte, int(length))
+		copy(next, i.key[:int(shared)])
+		i.key = next
+	} else {
+		i.key = i.key[:int(length)]
+	}
+	copy(i.key[int(shared):], src[int(start):int(start+nkey)])
+	i.value = src[int(start+nkey):int(start+nkey+nval)]
+	i.pos += int(start + nkey + nval)
+	if i.restartPos < len(i.restarts) && int(binary.LittleEndian.Uint32(i.restarts[i.restartPos:])) < i.pos {
+		i.err = boundedCorrupt("restart inside entry")
+		return false
+	}
+	return true
+}
diff --git a/leveldb/table/browser_bounded_test.go b/leveldb/table/browser_bounded_test.go
new file mode 100644
--- /dev/null
+++ b/leveldb/table/browser_bounded_test.go
@@ -0,0 +1,317 @@
+// Copyright 2026 Cypher browser contributors.
+// Use of this source code is governed by the BSD-style LICENSE at the module root.
+
+package table
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	stderrors "errors"
+	"testing"
+
+	"github.com/syndtr/goleveldb/leveldb/comparer"
+	"github.com/syndtr/goleveldb/leveldb/filter"
+	"github.com/syndtr/goleveldb/leveldb/opt"
+	"github.com/syndtr/goleveldb/leveldb/readbudget"
+	"github.com/syndtr/goleveldb/leveldb/storage"
+	"github.com/syndtr/goleveldb/leveldb/util"
+)
+
+// This fixture follows leveldb/iComparer: user keys ascend, sequence numbers
+// descend, and shortened separators retain the eight-byte internal suffix.
+type browserNativeTestComparer struct{}
+
+func (browserNativeTestComparer) Name() string { return "browser-native-test" }
+func (browserNativeTestComparer) Compare(a, b []byte) int {
+	x := comparer.DefaultComparer.Compare(a[:len(a)-8], b[:len(b)-8])
+	if x != 0 {
+		return x
+	}
+	m, n := binary.LittleEndian.Uint64(a[len(a)-8:]), binary.LittleEndian.Uint64(b[len(b)-8:])
+	if m > n {
+		return -1
+	}
+	if m < n {
+		return 1
+	}
+	return 0
+}
+func browserTestSeparator(dst, original, next []byte, successor bool) []byte {
+	u := original[:len(original)-8]
+	if successor {
+		dst = comparer.DefaultComparer.Successor(dst, u)
+	} else {
+		dst = comparer.DefaultComparer.Separator(dst, u, next[:len(next)-8])
+	}
+	if dst != nil && len(dst) < len(u) && comparer.DefaultComparer.Compare(u, dst) < 0 {
+		return append(dst, 1, 255, 255, 255, 255, 255, 255, 255)
+	}
+	return nil
+}
+func (browserNativeTestComparer) Separator(dst, a, b []byte) []byte {
+	return browserTestSeparator(dst, a, b, false)
+}
+func (browserNativeTestComparer) Successor(dst, b []byte) []byte {
+	return browserTestSeparator(dst, b, nil, true)
+}
+func browserNativeOptions() *opt.Options { return &opt.Options{Comparer: browserNativeTestComparer{}} }
+
+func browserTestKey(s string) []byte {
+	k := append([]byte(s), make([]byte, 8)...)
+	binary.LittleEndian.PutUint64(k[len(k)-8:], 257)
+	return k
+}
+func browserTestTable(t *testing.T) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	w := NewWriter(&buf, &opt.Options{Comparer: browserNativeTestComparer{}, BlockSize: 64, Compression: opt.SnappyCompression, Filter: filter.NewBloomFilter(10)}, nil, 0)
+	for _, k := range []string{"a", "b", "c", "d"} {
+		if err := w.Append(browserTestKey(k), bytes.Repeat([]byte(k), 100)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+func TestBrowserBoundedTableDifferential(t *testing.T) {
+	data := browserTestTable(t)
+	legacy, err := NewReader(bytes.NewReader(data), int64(len(data)), storage.FileDesc{}, nil, nil, browserNativeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer legacy.Release()
+	for _, s := range []string{"a", "aa", "b", "c", "d", "z"} {
