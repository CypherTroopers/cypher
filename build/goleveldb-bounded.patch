+++ b/leveldb/readbudget/budget_test.go
@@ -0,0 +1,79 @@
+package readbudget
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+)
+
+func TestBrowserBudgetLimitsScopeAndAggregate(t *testing.T) {
+	l := DefaultLimits()
+	l.MaxAllocationBytes = 64
+	b, err := New(context.Background(), l)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := b.WithValueLimit(32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = c.CopyValue(context.Background(), make([]byte, 33)); !errors.Is(err, ErrLimit) {
+		t.Fatal(err)
+	}
+	if b.Usage().AllocationBytes != 0 {
+		t.Fatal("copy allocated before value admission")
+	}
+	if _, err = c.CopyValue(context.Background(), make([]byte, 32)); err != nil {
+		t.Fatal(err)
+	}
+	if err = b.Alloc(context.Background(), 33); !errors.Is(err, ErrLimit) {
+		t.Fatal(err)
+	}
+	if b.Usage().AllocationBytes != 32 {
+		t.Fatal(b.Usage())
+	}
+	if _, err = c.WithValueLimit(33); !errors.Is(err, ErrInvalid) {
+		t.Fatal(err)
+	}
+	l.MaxWork = 0
+	if _, err = New(context.Background(), l); !errors.Is(err, ErrInvalid) {
+		t.Fatal(err)
+	}
+}
+
+func TestBrowserBudgetConcurrentCharge(t *testing.T) {
+	b, _ := New(context.Background(), DefaultLimits())
+	var wg sync.WaitGroup
+	for n := 0; n < 8; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 100; i++ {
+				if err := b.Alloc(context.Background(), 1); err != nil {
+					t.Error(err)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if b.Usage().AllocationBytes != 800 {
+		t.Fatal(b.Usage())
+	}
+}
+
+func TestBrowserBudgetCancelAndOverflow(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	b, _ := New(ctx, DefaultLimits())
+	cancel()
+	if err := b.Alloc(context.Background(), 1); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	b, _ = New(context.Background(), DefaultLimits())
+	if err := b.Stored(context.Background(), ^uint64(0)); !errors.Is(err, ErrLimit) {
+		t.Fatal(err)
+	}
+	if b.Usage() != (Usage{}) {
+		t.Fatal(b.Usage())
+	}
+}
