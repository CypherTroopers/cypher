+func browserRawPlain(data []byte) []byte {
+	r := append([]byte(nil), data...)
+	r = append(r, blockTypeNoCompression)
+	var c [4]byte
+	binary.LittleEndian.PutUint32(c[:], util.NewCRC(r).Value())
+	return append(r, c[:]...)
+}
+
+type browserVirtualReader struct {
+	footer    []byte
+	footerOff int64
+	meta      []byte
+	reads     []int64
+}
+
+func (r *browserVirtualReader) ReadAt(dst []byte, off int64) (int, error) {
+	r.reads = append(r.reads, off)
+	if off == r.footerOff {
+		return copy(dst, r.footer), nil
+	}
+	if off == 0 {
+		return copy(dst, r.meta), nil
+	}
+	return 0, stderrors.New("oversized index/filter payload was read")
+}
+func TestBrowserBoundedIndexAndFilterAdmission(t *testing.T) {
+	for _, kind := range []string{"index", "filter"} {
+		t.Run(kind, func(t *testing.T) {
+			meta := []byte{0, 0, 0, 0, 1, 0, 0, 0}
+			large := blockHandle{64, 1 << 20}
+			if kind == "filter" {
+				var handle [20]byte
+				n := encodeBlockHandle(handle[:], large)
+				key := []byte("filter.x")
+				meta = []byte{0, byte(len(key)), byte(n)}
+				meta = append(meta, key...)
+				meta = append(meta, handle[:n]...)
+				meta = append(meta, 0, 0, 0, 0, 1, 0, 0, 0)
+			}
+			raw := browserRawPlain(meta)
+			index := blockHandle{0, uint64(len(meta))}
+			if kind == "index" {
+				index = large
+			}
+			r := &browserVirtualReader{footerOff: 64 + (1 << 20) + 5, meta: raw, footer: browserFooter(blockHandle{0, uint64(len(meta))}, index)}
+			l := readbudget.DefaultLimits()
+			l.MaxStoredBytes = 64
+			b, _ := readbudget.New(context.Background(), l)
+			_, _, err := FindBounded(context.Background(), r, r.footerOff+footerLen, browserTestKey("a"), browserNativeOptions(), b)
+			if !stderrors.Is(err, readbudget.ErrLimit) || len(r.reads) != 2 || b.Usage().StoredBytes != uint64(len(raw)) || b.Usage().AllocationBytes > 128 {
+				t.Fatalf("%v reads=%v usage=%+v", err, r.reads, b.Usage())
+			}
+		})
+	}
+}
