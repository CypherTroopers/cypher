+	"github.com/syndtr/goleveldb/leveldb/util"
+)
+
+func browserTestDB(t *testing.T) *DB {
+	t.Helper()
+	db, err := OpenFile(t.TempDir(), &opt.Options{WriteBuffer: 1 << 20, BlockSize: 64, Compression: opt.SnappyCompression})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := db.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return db
+}
+func TestBrowserBoundedMemtableValueBeforeCopy(t *testing.T) {
+	db := browserTestDB(t)
+	payload := bytes.Repeat([]byte("x"), 256)
+	if err := db.Put([]byte("a"), payload, nil); err != nil {
+		t.Fatal(err)
+	}
+	s, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Release()
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	c, _ := b.WithValueLimit(32)
+	if _, err = s.GetBounded(context.Background(), []byte("a"), nil, c); !errors.Is(err, readbudget.ErrLimit) {
+		t.Fatal(err)
+	}
+	if b.Usage().AllocationBytes != 9 || b.Usage().StoredBytes != 0 {
+		t.Fatal("memtable value copied before limit", b.Usage())
+	}
+	v, err := s.Get([]byte("a"), nil)
+	if err != nil || !bytes.Equal(v, payload) {
+		t.Fatal("ordinary path changed", err)
+	}
+}
+func TestBrowserBoundedSnapshotSSTAndOwnership(t *testing.T) {
+	db := browserTestDB(t)
+	for n := 0; n < 8; n++ {
+		if err := db.Put([]byte(fmt.Sprintf("k%d", n)), bytes.Repeat([]byte{byte(n)}, 256), nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := db.CompactRange(util.Range{}); err != nil {
+		t.Fatal(err)
+	}
+	s, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for n := 0; n < 8; n++ {
+		key := []byte(fmt.Sprintf("k%d", n))
+		b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+		v, err := s.GetBounded(context.Background(), key, nil, b)
+		want, we := s.Get(key, nil)
+		if err != nil || we != nil || !bytes.Equal(v, want) {
+			t.Fatal(n, err, we)
+		}
+		if b.Usage().StoredBytes == 0 {
+			t.Fatal("SST path not exercised")
+		}
+		v[0] ^= 255
+		again, err := s.Get(key, nil)
+		if err != nil || !bytes.Equal(again, want) {
+			t.Fatal("returned bytes share backing")
+		}
+	}
+	if err := db.Put([]byte("k0"), []byte("new"), nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Delete([]byte("k1"), nil); err != nil {
+		t.Fatal(err)
+	}
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	old, err := s.GetBounded(context.Background(), []byte("k0"), nil, b)
+	if err != nil || len(old) != 256 {
+		t.Fatal("snapshot sequence changed", err)
+	}
+	if _, err = s.GetBounded(context.Background(), []byte("missing"), nil, b); err != ErrNotFound {
+		t.Fatal(err)
+	}
+	s.Release()
+	if _, err = s.GetBounded(context.Background(), []byte("k0"), nil, b); err != ErrSnapshotReleased {
+		t.Fatal(err)
+	}
+}
+func TestBrowserBoundedConcurrentWritesAndIndependentValues(t *testing.T) {
+	db := browserTestDB(t)
+	if err := db.Put([]byte("key"), []byte("before"), nil); err != nil {
+		t.Fatal(err)
+	}
+	s, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Release()
+	var wg sync.WaitGroup
+	for n := 0; n < 4; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 20; j++ {
+				b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+				v, err := s.GetBounded(context.Background(), []byte("key"), nil, b)
+				if err != nil || string(v) != "before" {
+					t.Error(err, string(v))
+					return
+				}
+				v[0] = 'X'
+			}
+		}()
+	}
+	for j := 0; j < 20; j++ {
+		if err := db.Put([]byte("key"), []byte(fmt.Sprintf("after%d", j)), nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	wg.Wait()
+}
+func TestBrowserBoundedCancelledInvalidAndRecordBudget(t *testing.T) {
+	db := browserTestDB(t)
+	s, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Release()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	if _, err = s.GetBounded(ctx, []byte("x"), nil, b); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if b.Usage() != (readbudget.Usage{}) {
+		t.Fatal(b.Usage())
+	}
+	if _, err = s.GetBounded(context.Background(), []byte("x"), nil, nil); !errors.Is(err, readbudget.ErrInvalid) {
+		t.Fatal(err)
+	}
+	l := readbudget.DefaultLimits()
+	l.MaxWork = 1
+	b, _ = readbudget.New(context.Background(), l)
+	if _, err = s.GetBounded(context.Background(), []byte("x"), nil, b); !errors.Is(err, readbudget.ErrLimit) {
+		t.Fatal(err)
+	}
+}
+
+func TestBrowserBoundedPrimitiveContextDoesNotOwnLease(t *testing.T) {
+	db := browserTestDB(t)
+	if err := db.Put([]byte("key"), []byte("value"), nil); err != nil {
+		t.Fatal(err)
+	}
+	s, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Release()
+	lease, cancelLease := context.WithCancel(context.Background())
+	defer cancelLease()
+	b, _ := readbudget.New(lease, readbudget.DefaultLimits())
+	primitive, cancel := context.WithCancel(context.Background())
+	if _, err = s.GetBounded(primitive, []byte("key"), nil, b); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	if v, err := s.GetBounded(context.Background(), []byte("key"), nil, b); err != nil || string(v) != "value" {
+		t.Fatal("old primitive poisoned lease", err)
+	}
+	cancelLease()
+	if _, err = s.GetBounded(context.Background(), []byte("key"), nil, b); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
+func TestBrowserBoundedRejectsSequenceOverflow(t *testing.T) {
+	db := browserTestDB(t)
+	fake := &Snapshot{db: db, elem: &snapshotElement{seq: keyMaxSeq + 1}}
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	if _, err := fake.GetBounded(context.Background(), []byte("key"), nil, b); !errors.Is(err, readbudget.ErrInvalid) {
+		t.Fatal(err)
+	}
+	if b.Usage() != (readbudget.Usage{}) {
+		t.Fatal(b.Usage())
+	}
+}
+
+func TestBrowserBoundedSSTNativeSeparatorsAndVersions(t *testing.T) {
+	db := browserTestDB(t)
+	keys := []string{"alpha/00000000", "charlie/00000000", "echo/00000000", "golf/00000000"}
+	for _, key := range keys {
+		if err := db.Put([]byte(key), bytes.Repeat([]byte(key), 32), nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	old, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer old.Release()
+	a := makeInternalKey(nil, []byte(keys[0]), 1, keyTypeVal)
+	c := makeInternalKey(nil, []byte(keys[1]), 2, keyTypeVal)
+	sep := db.s.icmp.Separator(nil, a, c)
+	if len(sep) < 8 || len(sep) >= len(a) || db.s.icmp.Compare(a, sep) >= 0 || db.s.icmp.Compare(sep, c) >= 0 {
+		t.Fatal("fixture did not exercise a valid shortened native separator")
+	}
+	if err = db.Put([]byte(keys[0]), []byte("new version"), nil); err != nil {
+		t.Fatal(err)
+	}
+	if err = db.Delete([]byte(keys[1]), nil); err != nil {
+		t.Fatal(err)
+	}
+	if err = db.CompactRange(util.Range{}); err != nil {
+		t.Fatal(err)
+	}
+	current, err := db.GetSnapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer current.Release()
+	for _, snap := range []*Snapshot{old, current} {
+		for _, key := range keys {
+			b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+			want, we := snap.Get([]byte(key), nil) // warm the ordinary shared reader first
+			got, ge := snap.GetBounded(context.Background(), []byte(key), nil, b)
+			if (we == nil) != (ge == nil) || (we == ErrNotFound) != (ge == ErrNotFound) || !bytes.Equal(want, got) {
+				t.Fatal("native SST differential", key, we, ge)
+			}
+			if b.Usage().StoredBytes == 0 {
+				t.Fatal("native SST was not read")
+			}
+		}
+	}
+}
