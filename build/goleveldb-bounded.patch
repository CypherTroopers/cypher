+func browserPlainEntry(key, value []byte) []byte {
+	var ints [30]byte
+	n := binary.PutUvarint(ints[:], 0)
+	n += binary.PutUvarint(ints[n:], uint64(len(key)))
+	n += binary.PutUvarint(ints[n:], uint64(len(value)))
+	r := append([]byte(nil), ints[:n]...)
+	r = append(r, key...)
+	return append(r, value...)
+}
+func browserSSTWithData(data []byte) []byte {
+	raw := browserRawPlain(data)
+	meta := []byte{0, 0, 0, 0, 1, 0, 0, 0}
+	metaBH := blockHandle{uint64(len(raw)), uint64(len(meta))}
+	raw = append(raw, browserRawPlain(meta)...)
+	var bh [20]byte
+	n := encodeBlockHandle(bh[:], blockHandle{0, uint64(len(data))})
+	index := browserPlainEntry(browserTestKey("z"), bh[:n])
+	index = append(index, 0, 0, 0, 0, 1, 0, 0, 0)
+	indexBH := blockHandle{uint64(len(raw)), uint64(len(index))}
+	raw = append(raw, browserRawPlain(index)...)
+	return append(raw, browserFooter(metaBH, indexBH)...)
+}
+func TestBrowserBoundedRejectsUnorderedChecksummedData(t *testing.T) {
+	data := browserPlainEntry(browserTestKey("b"), []byte("later"))
+	data = append(data, browserPlainEntry(browserTestKey("a"), []byte("earlier"))...)
+	data = append(data, 0, 0, 0, 0, 1, 0, 0, 0)
+	sst := browserSSTWithData(data)
+	b, _ := readbudget.New(context.Background(), readbudget.DefaultLimits())
+	if _, _, err := FindBounded(context.Background(), bytes.NewReader(sst), int64(len(sst)), browserTestKey("a"), browserNativeOptions(), b); err == nil || stderrors.Is(err, readbudget.ErrLimit) {
+		t.Fatal("unordered table accepted", err)
+	}
+}
