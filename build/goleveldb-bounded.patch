+		lk, lv, le := legacy.Find(browserTestKey(s), true, nil)
+		if (err == nil) != (le == nil) || !bytes.Equal(k, lk) || !bytes.Equal(v, lv) {
+			t.Fatalf("%s: bounded %v legacy %v", s, err, le)
+		}
+	}
