@@ -0,0 +1,61 @@
+// Copyright 2026 Cypher browser contributors.
+// Use of this source code is governed by the BSD-style LICENSE at the module root.
+
+package memdb
+
+import (
+	"context"
+	"github.com/syndtr/goleveldb/leveldb/readbudget"
+)
+
+// FindBounded follows the same skip list without changing it. Results borrow
+// append-only backing: the caller must retain its memtable reference until the
+// copy completes and must not Reset the memtable. The full-node Snapshot caller
+// holds that reference and applies the value-copy budget before allocation.
+func (p *DB) FindBounded(ctx context.Context, key []byte, b *readbudget.Budget) ([]byte, []byte, error) {
+	if p == nil {
+		return nil, nil, readbudget.ErrInvalid
+	}
+	if err := b.Check(ctx); err != nil {
+		return nil, nil, err
+	}
+	if err := b.CheckKey(uint64(len(key)), true); err != nil {
+		return nil, nil, err
+	}
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	node := 0
+	h := p.maxHeight - 1
+	for {
+		if err := b.Step(ctx); err != nil {
+			return nil, nil, err
+		}
+		next := p.nodeData[node+nNext+h]
+		cmp := 1
+		if next != 0 {
+			o := p.nodeData[next]
+			n := p.nodeData[next+nKey]
+			if err := b.CheckKey(uint64(n), true); err != nil {
+				return nil, nil, err
+			}
+			cmp = p.cmp.Compare(p.kvData[o:o+n], key)
+		}
+		if cmp < 0 {
+			node = next
+			continue
+		}
+		if cmp != 0 && h > 0 {
+			h--
+			continue
+		}
+		if next == 0 {
+			return nil, nil, ErrNotFound
+		}
+		o := p.nodeData[next]
+		end := o + p.nodeData[next+nKey]
+		if err := b.Check(ctx); err != nil {
+			return nil, nil, err
+		}
+		return p.kvData[o:end], p.kvData[end : end+p.nodeData[next+nVal]], nil
+	}
+}
diff --git a/leveldb/readbudget/budget.go b/leveldb/readbudget/budget.go
