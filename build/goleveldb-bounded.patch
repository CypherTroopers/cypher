+// Copyright 2026 Cypher browser contributors.
+// Use of this source code is governed by the BSD-style LICENSE at the module root.
+
+package leveldb
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+
+	"github.com/syndtr/goleveldb/leveldb/opt"
+	"github.com/syndtr/goleveldb/leveldb/readbudget"
+	"github.com/syndtr/goleveldb/leveldb/table"
+)
+
+var errBoundedInternalKey = errors.New("corrupt bounded internal key")
+
+// GetBounded is additive: ordinary Get, caches and compaction paths are unchanged.
+// Every call uses this snapshot's fixed sequence and a caller-owned aggregate
+// budget. Returned value bytes are owned. Release waits for an in-flight call;
+// synchronous file I/O is not forcibly interrupted when its context expires.
+func (snap *Snapshot) GetBounded(ctx context.Context, key []byte, ro *opt.ReadOptions, b *readbudget.Budget) ([]byte, error) {
+	if snap == nil {
+		return nil, readbudget.ErrInvalid
+	}
+	if err := b.Check(ctx); err != nil {
+		return nil, err
+	}
+	if err := b.CheckKey(uint64(len(key)), false); err != nil {
+		return nil, err
+	}
+	snap.mu.RLock()
+	defer snap.mu.RUnlock()
+	if err := b.Check(ctx); err != nil {
+		return nil, err
+	}
+	if snap.released {
+		return nil, ErrSnapshotReleased
+	}
+	if snap.db == nil || snap.elem == nil || snap.elem.seq > keyMaxSeq {
+		return nil, readbudget.ErrInvalid
+	}
+	if err := snap.db.ok(); err != nil {
+		return nil, err
+	}
+	if err := b.Alloc(ctx, uint64(len(key)+8)); err != nil {
+		return nil, err
+	}
+	ikey := make([]byte, len(key)+8)
+	copy(ikey, key)
+	binary.LittleEndian.PutUint64(ikey[len(key):], (snap.elem.seq<<8)|uint64(keyTypeSeek))
+	em, fm := snap.db.getMems()
+	if em != nil {
+		defer em.decref()
+	}
+	if fm != nil {
+		defer fm.decref()
+	}
+	for _, m := range [...]*memDB{em, fm} {
+		if m == nil {
+			continue
+		}
+		if err := b.Step(ctx); err != nil {
+			return nil, err
+		}
+		mk, mv, me := m.DB.FindBounded(ctx, ikey, b)
+		if me != nil && me != ErrNotFound {
+			return nil, me
+		}
+		if me == nil {
+			u, _, kt, err := boundedParseKey(mk)
+			if err != nil {
+				return nil, err
+			}
+			if snap.db.s.icmp.uCompare(u, key) == 0 {
+				if err := b.Check(ctx); err != nil {
+					return nil, err
+				}
+				if kt == keyTypeDel {
+					return nil, ErrNotFound
+				}
+				return b.CopyValue(ctx, mv)
+			}
+		}
+	}
+	v := snap.db.s.version()
+	defer v.release()
+	return v.getBounded(ctx, internalKey(ikey), ro, b)
+}
+
+func boundedParseKey(k []byte) ([]byte, uint64, keyType, error) {
+	if len(k) < 8 {
+		return nil, 0, 0, errBoundedInternalKey
+	}
+	n := binary.LittleEndian.Uint64(k[len(k)-8:])
+	kt := keyType(n & 255)
+	if kt > keyTypeVal {
+		return nil, 0, 0, errBoundedInternalKey
+	}
+	return k[:len(k)-8], n >> 8, kt, nil
+}
+
+// A finite scan preserves level/sequence selection while checking context on
+// non-overlapping table candidates too. It never samples seeks for compaction.
+func (v *version) getBounded(ctx context.Context, ikey internalKey, ro *opt.ReadOptions, b *readbudget.Budget) ([]byte, error) {
+	if v.closing {
+		return nil, ErrClosed
+	}
+	ukey := ikey.ukey()
+	for level, files := range v.levels {
+		if err := b.Step(ctx); err != nil {
+			return nil, err
+		}
+		found := false
+		var bestSeq uint64
+		var bestType keyType
+		var best []byte
+		for _, f := range files {
+			if err := b.Step(ctx); err != nil {
+				return nil, err
+			}
+			if len(f.imin) < 8 || len(f.imax) < 8 {
+				return nil, errBoundedInternalKey
+			}
+			if level == 0 {
+				if !f.overlaps(v.s.icmp, ukey, ukey) {
+					continue
+				}
+			} else {
+				if v.s.icmp.Compare(f.imax, ikey) < 0 {
+					continue
+				}
+				if v.s.icmp.uCompare(ukey, f.imin.ukey()) < 0 {
+					break
+				}
+			}
+			fk, fv, err := v.s.tops.findBounded(ctx, f, ikey, ro, b)
+			if err != nil && err != ErrNotFound {
+				return nil, err
+			}
+			if err == nil {
+				fu, seq, kt, err := boundedParseKey(fk)
+				if err != nil {
+					return nil, err
+				}
+				if v.s.icmp.uCompare(ukey, fu) == 0 && (!found || seq >= bestSeq) {
+					found = true
+					bestSeq = seq
+					bestType = kt
+					best = fv
+				}
+			}
+			if level > 0 {
+				break
+			}
+		}
+		if found {
+			if err := b.Check(ctx); err != nil {
+				return nil, err
+			}
+			if bestType == keyTypeDel {
+				return nil, ErrNotFound
+			}
+			return best, nil
+		}
+	}
+	if err := b.Check(ctx); err != nil {
+		return nil, err
+	}
+	return nil, ErrNotFound
+}
+
+func (t *tOps) findBounded(ctx context.Context, f *tFile, key []byte, ro *opt.ReadOptions, b *readbudget.Budget) (rk, rv []byte, err error) {
+	if err = b.Step(ctx); err != nil {
+		return nil, nil, err
+	}
+	r, err := t.s.stor.Open(f.fd)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer func() {
+		closeErr := r.Close()
+		if err == nil && closeErr != nil {
+			err = closeErr
+			rk = nil
+			rv = nil
+		}
+	}()
+	if err = b.Check(ctx); err != nil {
+		return nil, nil, err
+	}
+	// All on-disk blocks are checksummed. ro does not weaken bounded admission.
+	return table.FindBounded(ctx, r, f.size, key, t.s.o.Options, b)
+}
