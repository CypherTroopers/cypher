SRC_DIR=/root/go/src/github.com/cypherium/cypher
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:3b-instruct
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PERSIST_DIR=storage
CHROMA_COLLECTION=
RESET_INDEX=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
REQUEST_TIMEOUT=600
BATCH_NODES=200
RETRY_PER_BATCH=3
RETRY_SLEEP=5
LOG_LEVEL=INFO
FAILED_FILES_LOG=failed_files.txt
FAILED_FILES_MAX=5000
DB_PATH=./storage/chainchat.db
ENCRYPTION_KEY=
TOP_K=13
HOST=127.0.0.1
PORT=8808
RPC_URL=http://localhost:8000
RPC_TIMEOUT=10
RPC_VERIFY_SSL=true
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1
