# ============================
# Source
# ============================
SRC_DIR=/root/go/src/github.com/cypherium/cypher
# ============================
# Models
# ============================
LLM_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text:latest
# ============================
# Chunking
# ============================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# ============================
# Storage / Chroma
# ============================
PERSIST_DIR=storage_cs1000_ov200_nomic_latest
CHROMA_COLLECTION=cypher_src_nomic_latest_cs1000_ov200
RESET_INDEX=0
# ============================
# Retrieval
# ============================
TOP_K=12
# ============================
# Ollama (local)
# ============================
OLLAMA_BASE_URL=http://127.0.0.1:11434
REQUEST_TIMEOUT=600
# ============================
# Index build tuning
# ============================
BATCH_NODES=200
RETRY_PER_BATCH=3
RETRY_SLEEP=5
# ============================
# Logging / Fail-safe
# ============================
LOG_LEVEL=INFO
FAILED_FILES_LOG=failed_files.txt
FAILED_FILES_MAX=5000
